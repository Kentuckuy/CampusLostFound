// ===== FIRESTORE RULES - ATURAN KEAMANAN DATABASE =====
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Aturan untuk koleksi laporan 'reports'
    match /reports/{reportId} {
      
      // Semua pengguna yang terautentikasi (login) dapat membaca seluruh laporan
      allow read: if request.auth != null;
      
      // Pembuatan laporan baru hanya diizinkan jika ownerId dokumen sama persis dengan UID user yang login
      allow create: if request.auth != null && 
                    request.resource.data.ownerId == request.auth.uid;
      
      // Update dan Delete HANYA dapat dilakukan oleh pemilik sah laporan (ownerId dokumen yang sudah ada)
      allow update, delete: if request.auth != null && 
                               resource.data.ownerId == request.auth.uid;
    }
    
    // Tolak akses dokumen lainnya secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
